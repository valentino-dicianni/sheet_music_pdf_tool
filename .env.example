# Telegram bot (copy to .env, never commit .env)
TELEGRAM_BOT_TOKEN=
# optional: comma separated Telegram user ids allowed to use the bot; empty = anyone
ALLOWED_USERS=

# optional, lets the bot receive PDFs above 20 MB directly (up to 2 GB): https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
